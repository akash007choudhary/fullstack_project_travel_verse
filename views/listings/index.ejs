<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wander_lust</title>
</head>
<body>
    <form action="/listings/new" method="get">
        <button type="submit">Add new listing</button>
    </form>
    <ul>
        <% for( let list of all_listings) {%>
            <li>
                <a href="/listings/<%= list._id %>"><%= list.title %></a>
            </li>
        <% } %>
    </ul>
    
</body>
</html>