
<% layout("/layouts/broilerplate") %>

<% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>


<% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>


<!-- Hero / Brand Section -->
<section class="travel-hero">
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fa-solid fa-compass"></i>
            <span>YOUR NEXT ADVENTURE STARTS HERE</span>
        </div>

        <h1>
            Find your <span class="hero-highlight">somewhere.</span>
        </h1>

        <p class="hero-description">
            Extraordinary stays, hidden gems, and unforgettable journeys.
            Your world is waiting to be explored.
        </p>

        <div class="hero-bottom">
            <div class="hero-brand">
                <span class="brand-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </span>
                <span>Discover more with <strong>Travel Verse</strong></span>
            </div>

            <div class="hero-decoration">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>

        <div class="hero-compass">
            <i class="fa-regular fa-compass"></i>
        </div>

        <div class="floating-card floating-card-top">
            <i class="fa-solid fa-heart"></i>
            <span>Places you'll love</span>
        </div>

        <div class="floating-card floating-card-bottom">
            <i class="fa-solid fa-earth-asia"></i>
            <span>Explore the extraordinary</span>
        </div>
    </div>
</section>


<!-- Category Bar -->
<div class="category-bar">

    <a href="/listings?category=Trending" class="category">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
        <span>Hot</span>
    </a>

    <a href="/listings?category=Mountains" class="category">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountains</p>
        <span>Popular</span>
    </a>

    <a href="/listings?category=Beachfront" class="category">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beachfront</p>
        <span>Trending</span>
    </a>

    <a href="/listings?category=Cabins" class="category">
        <i class="fa-solid fa-house"></i>
        <p>Cabins</p>
        <span>Cozy</span>
    </a>

    <a href="/listings?category=Lakefront" class="category">
        <i class="fa-solid fa-water"></i>
        <p>Lakefront</p>
        <span>Popular</span>
    </a>

    <a href="/listings?category=Camping" class="category">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
        <span>Adventure</span>
    </a>

    <a href="/listings?category=City%20Stays" class="category">
        <i class="fa-solid fa-city"></i>
        <p>City Stays</p>
        <span>Explore</span>
    </a>

    <a href="/listings?category=Arctic" class="category">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
        <span>Unique</span>
    </a>

    <a href="/listings?category=Amazing%20Pools" class="category">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
        <span>Popular</span>
    </a>

    <a href="/listings?category=Nature" class="category">
        <i class="fa-solid fa-tree"></i>
        <p>Nature</p>
        <span>Relax</span>
    </a>

</div>



<!-- <h1 class="listings-heading">All Listings</h1> -->


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 listings-container">

    <% for(let list of all_listings) { %>

        <a href="/listings/<%= list._id %>" class="listing-link">
                        
              <div class="col">

            <div class="card listing-card">

                <img 
                    src="<%= list.image.url %>" 
                    class="card-img-top listing-image" 
                    alt="listing_image"
                >
                <div class="card-img-overlay"></div>
                <div class="card-body">

                    <h5 class="card-title">
                        <%= list.title %>
                    </h5>

                    <p class="card-text">
                        <%= list.description %>
                    </p>

                    <p class="listing-price">
                        ₹<%= list.price.toLocaleString("en-IN")  %> / night
                    </p>

                </div>

                

            </div>

        </div>      
                    
        </a>
        

    <% } %>

</div>

