
<% layout("/layouts/broilerplate") %>

<% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>


<% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>


<h1 class="listings-heading">All Listings</h1>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 listings-container">

    <% for(let list of all_listings) { %>

        <a href="/listings/<%= list._id %>" class="listing-link">
                        
              <div class="col">

            <div class="card listing-card">

                <img 
                    src="<%= list.image.url %>" 
                    class="card-img-top listing-image" 
                    alt="listing_image"
                >
                <div class="card-img-overlay"></div>
                <div class="card-body">

                    <h5 class="card-title">
                        <%= list.title %>
                    </h5>

                    <p class="card-text">
                        <%= list.description %>
                    </p>

                    <p class="listing-price">
                        ₹<%= list.price.toLocaleString("en-IN")  %> / night
                    </p>

                </div>

                

            </div>

        </div>      
                    
        </a>
        

    <% } %>

</div>

