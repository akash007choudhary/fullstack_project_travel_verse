
<% layout("/layouts/broilerplate") %>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h1 class="mb-4"><%= user.title %></h1>

            <div class="card listing-details-card">

                <img
                    src="<%= user.image.url %>"
                    class="card-img-top listing-details-image"
                    alt="listing_image"
                >

                <div class="card-body">

                    <p class="card-text listing-description">
                        <%= user.description %>
                    </p>

                    <h5 class="listing-price">
                        &#8377; <%= user.price.toLocaleString("en-IN") %> / night
                    </h5>

                    <p class="card-text">
                        <strong>Location:</strong> <%= user.location %>
                    </p>

                    <p class="card-text">
                        <strong>Country:</strong> <%= user.country %>
                    </p>

                    <div class="mt-4">
                        <a
                            href="/listings/<%= user._id %>/edit"
                            class="btn btn-primary add-btn"
                        >
                            Edit
                        </a>

                        <form
                            method="POST"
                            action="/listings/<%= user._id %>?_method=DELETE"
                            class="d-inline"
                        >
                            <button type="submit" class="btn btn-dark">
                                Delete
                            </button>
                        </form>
                    </div>

                    <hr class="my-4">

                    <h4 class="mb-3">Leave a Review</h4>

                    <form
                        action="/listings/<%= user._id %>/reviews"
                        method="POST"
                        class="needs-validation"
                        novalidate
                    >

                        <div class="mb-3">
                            <label for="rating" class="form-label">
                                Rating
                            </label>

                            <input
                                type="range"
                                class="form-range"
                                name="review[rating]"
                                id="rating"
                                min="1"
                                max="5"
                            >

                            <div class="form-text">
                                Rate this listing from 1 to 5.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label">
                                Comments
                            </label>

                            <textarea
                                name="review[comment]"
                                id="comment"
                                class="form-control"
                                rows="4"
                                placeholder="Share your experience..."
                                required
                            ></textarea>

                            <div class="invalid-feedback">
                                Please enter your review.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary add-btn">
                            Submit Review
                        </button>

                    </form>

                    
                    
                    <hr class="my-4">

                    <h4 class="mb-4">Guest Reviews</h4>

                    <div class="row">
                        <% for (let review of user.reviews) { %>
                            <div class="col-md-6 mb-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between">
                                            <strong>Guest</strong>
                                            <span>⭐ <%= review.rating %>/5</span>
                                            
                                        </div>

                                        <small class="text-muted">
                                            <%= new Date(review.createdAt).toLocaleDateString("en-IN") %>
                                        </small>

                                        <p class="mt-3 mb-0"><%= review.comment %></p>

                                            <form method="POST" action="/listings/<%= user._id %>/reviews/<%= review._id %>?_method=DELETE">
                                         <button class="btn btn-sm btn-outline-danger">Delete</button>
</form>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <% if (user.reviews.length === 0) { %>
                        <p class="text-muted">No reviews yet.</p>
                    <% } %>


                    

                    

                </div>
            </div>

        </div>
    </div>
</div>

