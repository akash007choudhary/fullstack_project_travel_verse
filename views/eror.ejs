<% layout("/layouts/broilerplate") %>

<div class="alert alert-danger col-6 offset-3 mt-4 d-flex align-items-center" role="alert">

    <svg class="bi flex-shrink-0 me-3"
         width="24"
         height="24"
         role="img"
         aria-label="Danger:">
        <use href="#exclamation-triangle-fill"></use>
    </svg>

    <div>
        <h4 class="alert-heading mb-0">
            <%= message %>
        </h4>
    </div>

</div>